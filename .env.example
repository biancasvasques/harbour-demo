# Set in Vercel (Project → Settings → Environment Variables). Never commit the values.

# Set automatically by the Neon integration.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Production webhook URL of the n8n workflow (secret path).
N8N_WEBHOOK_URL=
# Shared key n8n sends in the x-harbour-key header when it calls /api/tools/*. At least 24 characters.
TOOLS_SECRET=

# Team panel login (/admin).
PANEL_PASSWORD=
# Signs the panel session cookie. At least 24 random characters.
PANEL_SECRET=
